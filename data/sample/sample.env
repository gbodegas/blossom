# The sample week: a synthetic scenario for showing Blossom, kept apart from
# the family's own state. Four ordinary assignments, each with one date from
# the school portal, in the school week of September 7, 2026.
#
# Load it after .env, so the household's time zone and the model key come
# from there and everything below overrides the family's paths:
#
#     uv run --env-file .env --env-file data/sample/sample.env uvicorn blossom.app:app --reload
#
# The three state files live under .local/sample/, so nothing here touches
# the family's drafts, decisions, signals, or requests.
BLOSSOM_FIXTURE_PATH=data/sample
BLOSSOM_TODAY=2026-09-07
BLOSSOM_DATABASE_PATH=.local/sample/blossom.sqlite3
BLOSSOM_CHECKPOINT_PATH=.local/sample/checkpoints.sqlite3
BLOSSOM_TRACE_PATH=.local/sample/traces.sqlite3
BLOSSOM_SAMPLE=1
