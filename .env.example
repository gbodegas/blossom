# Blossom runs against synthetic fixtures without credentials. Every variable
# below is optional; the defaults shown are what the application uses when the
# variable is unset.
#
# Relative values are resolved against the repository root, not the working
# directory, so these mean the same thing wherever the process is started from.
#
# Nothing here is read automatically. To load this file, start the app with:
#
#     uv run --env-file .env uvicorn blossom.app:app --reload

# Where the synthetic fixture JSON lives.
BLOSSOM_FIXTURE_PATH=data/synthetic

# Where drafts and the decisions about them are recorded, so the parent's
# queue survives a restart. Project state itself is still built in memory at
# startup. Same guard as the saved-state file: not on a share, not in a synced
# folder.
BLOSSOM_DATABASE_PATH=.local/blossom.sqlite3

# Where a graph's saved state lives: its pause and any draft waiting for
# approval. A separate file from project state on purpose. It may not be on a
# network share or inside a synced folder such as OneDrive; the app refuses to
# start if it is, because a write-ahead log there can corrupt the database and
# a synced copy would carry schoolwork off this machine.
BLOSSOM_CHECKPOINT_PATH=.local/checkpoints.sqlite3

# Anthropic API key for the plan graph's two model calls. Every fixture-backed
# page works without it, and the graph refuses to build without one rather
# than failing partway through a run. Never commit a real value;
# this file is an example and .env is ignored by git.
#
# The endpoint and the connection are fixed in code. ANTHROPIC_API_URL,
# ANTHROPIC_BASE_URL, ANTHROPIC_PROXY, LANGSMITH_GATEWAY, HTTP_PROXY,
# HTTPS_PROXY, ALL_PROXY, and SSL_CERT_FILE are read by the model library or
# its HTTP client on their own but are not honored here, so a shell cannot
# reroute a request or change which certificates it trusts.
ANTHROPIC_API_KEY=

# The household's time zone, as an IANA key. Required, with no default: "due
# this week" is a question about the days she lives in, and reading the date
# off a UTC clock runs the week a day early for most of an American evening.
# The app refuses to start without it rather than guess.
BLOSSOM_TIMEZONE=America/New_York

# Pins the system clock to a fixed date. Unset means use the real clock.
#
# The synthetic fixtures carry fixed August 2026 due dates, so a run outside
# that week shows an empty "due this week" page. That is correct behavior. Pin
# the clock to see the fixtures.
BLOSSOM_TODAY=2026-08-19
