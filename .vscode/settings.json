{
  // Use the mypy and ruff installed in the selected interpreter rather than the
  // copies bundled with each extension.
  //
  // pyproject.toml pins mypy 1.17.1 and ruff 0.12.9, and CI runs exactly those.
  // Bundled copies follow the extension release schedule, so their diagnostics
  // can disagree with CI in either direction.
  "mypy-type-checker.importStrategy": "fromEnvironment",
  "ruff.importStrategy": "fromEnvironment",

  // Run the suite from the Test Explorer. testpaths is already set in
  // pyproject.toml; this makes the extension agree with it.
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"]

  // python.defaultInterpreterPath is not set here. It does not force an
  // interpreter. VS Code stores the actual selection in per-user workspace
  // state and only consults this setting when nothing has been selected yet.
  // It would also be a Windows-specific path. Select the interpreter through
  // the command palette instead; VS Code discovers a workspace-root .venv on
  // its own.
}
